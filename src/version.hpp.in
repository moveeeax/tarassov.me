/**
 * @file version.hpp.in
 * @brief Single source of the application version.
 *
 * CMake's configure_file() renders this into <build>/generated/version.hpp
 * from project(VERSION ...) in CMakeLists.txt — bump the version THERE. That
 * baked value is what Core::version(), GET /health and GET / report for every
 * ordinary build, and scripts/check-version-sync.sh fails CI if it drifts from
 * the newest CHANGELOG release heading.
 *
 * Tagged release builds stamp the tag in instead: .github/workflows/release.yml
 * passes the tag as the Dockerfile's APP_VERSION build arg, which becomes
 * -DPROJECT_VERSION_OVERRIDE and replaces PROJECT_VERSION before this file is
 * configured.
 *
 * Nothing propagates from here to Helm: the appVersion in every chart's
 * Chart.yaml and the version in vcpkg.json are bumped by hand in the release
 * commit. (Spelled without a glob on purpose — a slash-star pair inside a
 * block comment trips -Wcomment, and CI builds with -Werror.)
 */

#pragma once

#define CPP_API_VERSION "@PROJECT_VERSION@"
